{
  "name": "@nexora/ui",
  "version": "0.1.0",
  "description": "Componentes de UI para IoT industrial, con una capa opcional para hablar con dispositivos por Portal",
  "keywords": [
    "iot",
    "react",
    "components",
    "portal",
    "telemetry",
    "realtime",
    "websocket",
    "esp32",
    "dashboard"
  ],
  "license": "MIT",
  "author": "Nexora",
  "homepage": "https://github.com/Camilo959/nexora-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Camilo959/nexora-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Camilo959/nexora-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "assets",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/components/iot/index.d.ts",
      "import": "./dist/index.js"
    },
    "./portal": {
      "types": "./dist/types/portal/index.d.ts",
      "import": "./dist/portal.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
